{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "cargo": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchPackagePrefixes": ["cratefield-"],
      "groupName": "cratefield crates"
    }
  ]
}
